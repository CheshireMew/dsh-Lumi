{
  "name": "@dsh-anime/desktop",
  "description": "Electron desktop host for the DeepSeek Harness anime experience",
  "version": "0.1.0-rc.5",
  "private": true,
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc -b && tsdown",
    "dev": "pnpm run build && electron .",
    "start": "electron .",
    "test": "pnpm --workspace-root exec vitest run apps/desktop/tests",
    "test:e2e": "pnpm --workspace-root run build:anime && pnpm run test:e2e:built",
    "test:e2e:built": "tsx e2e/desktop.e2e.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh": "workspace:^",
    "@deepseek-ai/dsh-app-boot": "workspace:^",
    "@deepseek-ai/dsh-base": "workspace:^",
    "@deepseek-ai/dsh-home-paths": "workspace:^",
    "@deepseek-ai/dsh-host-webserver": "workspace:^",
    "@deepseek-ai/dsh-web-app": "workspace:^",
    "@dsh-anime/bundle-desktop": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "electron": "43.4.0",
    "playwright": "^1.49.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "files": [
    "lib",
    "assets"
  ]
}
